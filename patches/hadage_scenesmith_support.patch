+def ensure_navmesh(sim, sim_settings):
+    if sim.pathfinder.is_loaded:
+        return sim
+
+    print("[WARN] Pathfinder is not initialized. Recomputing navmesh...")
+
+    navmesh_settings = habitat_sim.nav.NavMeshSettings()
+    navmesh_settings.set_defaults()
+
+    agent_radius = sim_settings.get("agent_radius", 0.2)
+    sensor_height = sim_settings.get("sensor_height", 1.5)
+    move_amount = sim_settings.get("move_actuation_amount", 0.06)
+
+    navmesh_settings.agent_radius = agent_radius
+    navmesh_settings.agent_height = sensor_height
+    navmesh_settings.cell_size = move_amount / 2.0
+    navmesh_settings.edge_max_len = agent_radius * 8.0
+
+    if hasattr(navmesh_settings, "include_static_objects"):
+        navmesh_settings.include_static_objects = sim_settings.get(
+            "navmesh_include_static_objects", True
+        )
+
+    ok = sim.recompute_navmesh(sim.pathfinder, navmesh_settings)
+    print(f"[INFO] recompute_navmesh -> {ok}, area={sim.pathfinder.navigable_area}")
+
     return sim
